rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny Catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // 1. Primitive Definitions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 2. Validation Helpers
    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stockQuantity']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.price is number && data.price >= 0 &&
             data.stockQuantity is int && data.stockQuantity >= 0 &&
             (!data.keys().hasAny(['category']) || (data.category is string && data.category.size() <= 50));
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['items', 'totalAmount', 'paymentMethod', 'status', 'timestamp']) &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number && data.totalAmount >= 0 &&
             data.status in ['completed', 'pending', 'refunded'] &&
             data.timestamp == request.time;
    }

    function isValidEmployee(data) {
      return data.keys().hasAll(['name', 'email', 'role']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100 &&
             data.role is string && data.role.size() <= 50;
    }

    function isValidCustomer(data) {
      return data.keys().hasAll(['name', 'email']) &&
             data.name is string && data.name.size() <= 100 &&
             data.email is string && data.email.size() <= 100;
    }

    function isValidCampaign(data) {
      return data.keys().hasAll(['name', 'type', 'content', 'status']) &&
             data.name is string && data.name.size() <= 100 &&
             data.type in ['sms', 'email', 'social'] &&
             data.status in ['draft', 'active', 'completed'];
    }

    // 3. Collection Rules
    
    // Products Collection
    match /products/{productId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isSignedIn() && isValidProduct(incoming()) && (
        // Action: Stock Update
        incoming().diff(existing()).affectedKeys().hasOnly(['stockQuantity', 'updatedAt'])
        // Action: Price Update
        || incoming().diff(existing()).affectedKeys().hasOnly(['price', 'updatedAt', 'name'])
      );
      allow delete: if isSignedIn(); // In a real app, restrict to Admin
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow list: if isSignedIn() && (resource.data.employeeId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow get: if isSignedIn();
      allow create: if isSignedIn() && isValidTransaction(incoming()) && isValidId(transactionId);
      allow update: if false; // Transactions are immutable once created in this logic
    }

    // Employees Collection
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidEmployee(incoming()) && isValidId(employeeId);
    }

    // Customers Collection
    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidCustomer(incoming()) && isValidId(customerId);
    }

    // Campaigns Collection
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && isValidCampaign(incoming()) && isValidId(campaignId);
    }
  }
}
